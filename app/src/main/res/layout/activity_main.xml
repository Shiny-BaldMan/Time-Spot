<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F6F7F2" android:fillViewport="true" android:theme="@style/Theme.Timecaptule.Auth"
    tools:context=".MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="TIME SPOT  /  나중에 만나는 오늘" android:textSize="12sp"
            android:textStyle="bold" android:letterSpacing="0.06" android:textColor="#3F6557" android:layout_marginTop="20dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="오늘의 기억,\n미래의 우리에게." android:textSize="34sp" android:textStyle="bold"
            android:textColor="#203D32" android:lineSpacingExtra="4dp" android:layout_marginTop="30dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="이름 대신 닉네임으로 시작하는\n우리만의 작은 추억 보관소" android:textSize="16sp"
            android:textColor="#59675F" android:lineSpacingExtra="5dp" android:layout_marginTop="14dp" android:layout_marginBottom="28dp" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="24dp" app:cardElevation="0dp"
            app:strokeColor="#DFE6DD" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/authTabs" android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/loginTab">
                    <com.google.android.material.button.MaterialButton android:id="@+id/loginTab"
                        style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                        android:layout_height="52dp" android:layout_weight="1" android:text="로그인" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/signupTab"
                        style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                        android:layout_height="52dp" android:layout_weight="1" android:text="회원가입" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView android:id="@+id/authTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="다시 만나 반가워요" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="#203D32" android:layout_marginTop="24dp" />
                <TextView android:id="@+id/authDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="닉네임과 비밀번호로 기억을 이어 가세요." android:textColor="#59675F"
                    android:textSize="14sp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/nicknameLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="닉네임">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/nicknameInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="text|textNoSuggestions" android:singleLine="true" android:imeOptions="actionNext"
                        android:autofillHints="username" android:maxLength="20" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/checkNickname"
                    style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:text="닉네임 중복 확인"
                    android:visibility="gone" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="비밀번호" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPassword" android:maxLines="1" android:imeOptions="actionDone"
                        android:autofillHints="password" android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/signupNote" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="닉네임은 영문·숫자·밑줄 2~20자이며 변경할 수 없어요.\n대소문자는 구분하지 않아요. 비밀번호는 8자 이상 입력해 주세요."
                    android:textSize="13sp" android:textColor="#59675F" android:lineSpacingExtra="4dp"
                    android:layout_marginTop="16dp" android:visibility="gone" />
                <TextView android:id="@+id/authStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#994122" android:textSize="14sp" android:accessibilityLiveRegion="polite"
                    android:layout_marginTop="12dp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/authSubmit"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:layout_marginTop="16dp" android:text="로그인" android:textSize="16sp" app:cornerRadius="16dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/recoveryButton"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:text="비밀번호를 잊으셨나요?" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="닉네임과 비밀번호로 가입하고 로그인할 수 있어요."
            android:textSize="12sp" android:textColor="#59675F" android:gravity="center" android:layout_marginTop="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/previewButton"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="가입 없이 체험하기 →" />
    </LinearLayout>
</ScrollView>
